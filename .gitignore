# TA cache (real tokens/sign) and temp signing files getTA() generates at
# runtime for any ARCA service - glob'd since the temp files carry a random
# per-call suffix (see lib/core/auth.js) and the service name varies.
/.lastTokensH/ta-*.json
/.lastTokensH/LoginTicketRequest-*.xml
/.lastTokensH/LoginTicketRequest-*.cms
/.lastTokensP/ta-*.json
/.lastTokensP/LoginTicketRequest-*.xml
/.lastTokensP/LoginTicketRequest-*.cms
